# Demostración local. Sus cambios se guardan únicamente en api/.data/.
# Nunca se usa como respaldo automático cuando falla una conexión real.
DEMO_MODE=true
# CAMBIAR AQUÍ LA RUTA BASE DEL PORTAL; debe coincidir con VITE_BASE_PATH en web/.env.
BASE_PATH=/pulsoAtom
API_HOST=127.0.0.1
PORT=4001
PUBLIC_ORIGIN=http://127.0.0.1:3000
SESSION_HOURS=8
COOKIE_SECURE=false
APP_TIMEZONE=America/Tegucigalpa

# API TD reutilizable para S3 y SMTP. Estos endpoints no usan JWT.
TD_API_BASE_URL=https://apps.3c.group/td/api/v1

# Base propia de Pulso: catálogo, cuentas, evaluaciones y auditoría.
# Para usarla: DEMO_MODE=false, configurar y ejecutar db:migrate y db:seed.
APP_DB_HOST=
APP_DB_PORT=3306
APP_DB_NAME=dbPulsosAtom
APP_DB_USER=
APP_DB_PASSWORD=
APP_DB_SSL=false

# Fuente Atom, independiente de la base de Pulso.
# Usar una cuenta de solo lectura para las tablas de origen.
ATOM_DB_ENGINE=mysql
ATOM_DB_HOST=
ATOM_DB_PORT=3306
ATOM_DB_NAME=
ATOM_DB_USER=
ATOM_DB_PASSWORD=
ATOM_DB_SSL=false
ATOM_CONVERSATIONS_TABLE=tblConversaciones
ATOM_MESSAGES_TABLE=tblEventosConversacion
ATOM_AGENTS_TABLE=tblAsesores
ATOM_DOCUMENTS_TABLE=tblDocumentosConversacion
ATOM_CHANNELS_TABLE=tblCanales
ATOM_COUNTRIES_TABLE=dbSomos3c_2.tblCatalogoPaises

# Acceso por correo con credenciales de tblPersonas en Somos3C (misma conexión física que ATOM_DB_*).
# Pulso solo lee esta base; las concesiones y sesiones se guardan en APP_DB_*.
IDENTITY_MODE=person-email
IDENTITY_DB_NAME=dbSomos3c_2
IDENTITY_USERS_TABLE=tblUsuariosPortal
IDENTITY_USER_ROLES_TABLE=tblUsuarioRoles
IDENTITY_ROLES_TABLE=tblRoles
IDENTITY_PEOPLE_TABLE=tblPersonas

# Solo se mostrarán enlaces de origen cuando lleguen URLs válidas con los datos.
ATOM_WEB_BASE_URL=

# Modelos locales vía GatewayAgents. Solo backend; nunca usar VITE_* para el token.
# Clef y Gemma son los dos perfiles predeterminados; AI_MODEL_PROFILES no es necesario.
# Los perfiles/credenciales antiguos de OpenAI y Gemini no habilitan ejecuciones.
# En Evaluaciones > Herramientas internas > Modelos locales consultar el Gateway,
# elegir herramientas e IDs exactos, activar y guardar. MySQL versiona esos campos
# sin secretos; el guardado activa política dual y pausa el diario para el piloto.
GATEWAY_BASE_URL=
AGENT_SHARED_TOKEN=
GATEWAY_PORTAL_KEY=portal-pulso
# Alternativa inicial por entorno. La configuración guardada en portal tiene prioridad.
CLEF_TOOL_KEY=
CLEF_MODEL=
CLEF_TIMEOUT_MS=180000
CLEF_MAX_TOKENS=16000
CLEF_TEMPERATURE=0
CLEF_RESPONSE_FORMAT=json_schema
CLEF_EVALUATION_ENABLED=false
GEMMA_TOOL_KEY=
# Confirmar ID exacto en GET /v1/models a través del Gateway.
GEMMA_MODEL=
GEMMA_TIMEOUT_MS=180000
GEMMA_MAX_TOKENS=16000
GEMMA_TEMPERATURE=0
# Si el servidor admite solo json_object, cambiarlo explícitamente tras verificarlo.
GEMMA_RESPONSE_FORMAT=json_schema
GEMMA_EVALUATION_ENABLED=false

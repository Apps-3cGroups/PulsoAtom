# Demostración local. Sus cambios se guardan únicamente en api/.data/.
# Nunca se usa como respaldo automático cuando falla una conexión real.
DEMO_MODE=true
API_HOST=127.0.0.1
API_PORT=4001
PUBLIC_ORIGIN=http://127.0.0.1:3000
SESSION_HOURS=8
COOKIE_SECURE=false
APP_TIMEZONE=America/Tegucigalpa

# Base propia de Pulso: catálogo, cuentas, evaluaciones y auditoría.
# Para usarla: DEMO_MODE=false, configurar y ejecutar db:migrate y db:seed.
APP_DB_HOST=
APP_DB_PORT=3306
APP_DB_NAME=pulso
APP_DB_USER=
APP_DB_PASSWORD=
APP_DB_SSL=false

# Fuente Atom, independiente de la base de Pulso.
# Compartir luego motor, tablas y relaciones. Usar una cuenta de solo lectura.
ATOM_DB_ENGINE=mysql
ATOM_DB_HOST=
ATOM_DB_PORT=3306
ATOM_DB_NAME=
ATOM_DB_USER=
ATOM_DB_PASSWORD=
ATOM_DB_SSL=false
ATOM_CONVERSATIONS_TABLE=
ATOM_MESSAGES_TABLE=
ATOM_AGENTS_TABLE=
ATOM_COUNTRIES_TABLE=

# Aún no se ejecutan llamadas a modelos. El adaptador se implementará después.
AI_PROVIDER=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# Solo se mostrarán enlaces de origen cuando lleguen URLs válidas con los datos.
ATOM_WEB_BASE_URL=
